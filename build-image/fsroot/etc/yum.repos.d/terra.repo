[terra]
name=T Terra
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
type=rpm
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=0
enabled_metadata=1

[terra-rawhide]
name=T Terra Rawhide
metalink=https://tetsudou.fyralabs.com/metalink?repo=terrarawhide&arch=$basearch
type=rpm
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=0
enabled_metadata=1
enabled=0