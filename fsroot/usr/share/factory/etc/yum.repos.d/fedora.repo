[fedora]
name=T Fedora
metalink=https://mirrors.fedoraproject.org/metalink?repo=rawhide&arch=$basearch
repo_gpgcheck=0
type=rpm
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-rawhide-$basearch

[updates]
name=T Fedora Updates
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-frawhide&arch=$basearch
repo_gpgcheck=0
type=rpm
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-rawhide-$basearch
enabled=0

[updates-testing]
name=T Fedora Updates Testing
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-testing-frawhide&arch=$basearch
repo_gpgcheck=0
type=rpm
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-rawhide-$basearch
enabled=0

# WARNING: 