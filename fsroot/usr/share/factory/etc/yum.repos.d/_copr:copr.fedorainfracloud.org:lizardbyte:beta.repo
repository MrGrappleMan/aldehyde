[copr:copr.fedorainfracloud.org:lizardbyte:beta]
name=C lizardbyte beta
baseurl=https://download.copr.fedorainfracloud.org/results/lizardbyte/beta/fedora-$releasever-$basearch/
gpgkey=https://download.copr.fedorainfracloud.org/results/lizardbyte/beta/pubkey.gpg
type=rpm-md
#gpgcheck=1#toBeReconsidered
repo_gpgcheck=0
enabled_metadata=1
enabled=1
skip_if_unavailable=True
fastestmirror=True
max_parallel_downloads=20
metadata_expire=8h
countme=1
