[Plymouth Theme]
Name=Aldehyde Boot Theme
Description=Inbuilt theme for the Aldehyde BootC image
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/aldy_bootui
Transition=none
TransitionDuration=0.0
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.682
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
MessageBelowAnimation=true
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000

[boot-up]
UseEndAnimation=true

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
_Title=Upgrading...
_SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
_Title=Upgrading System...
_SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
_Title=Upgrading Firmware...
_SubTitle=Do not turn off your computer
